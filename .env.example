# DashScope / OpenAI-compatible API Configuration
DASHSCOPE_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# Paths (optional, defaults shown)
# DATA_DIR=./data
# OUTPUT_DIR=./output
# XMIND_BASE_PATH=./xmind_base


# V0.4 protected deployment (the defaults shown below are intentionally safe)
# P2X_DEPLOYMENT_MODE=public
# P2X_PUBLIC_DEMO_ENABLED=0
# P2X_RESEARCH_MAP_ENABLED=0
# P2X_EVIDENCE_ENABLED=0
# P2X_ALLOW_PRIVATE_WORKER=0
# P2X_DISABLE_WORKER=1
# Server-only: P2X_EVIDENCE_AUTH_JSON={} (hashed admin tokens, reviewer HMAC keys)
# Browser build for anonymous landing: VITE_PUBLIC_LANDING=1
# Localhost developer compatibility ONLY: P2X_DEPLOYMENT_MODE=local
